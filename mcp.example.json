{
  "mcpServers": {
    "personal-profile": {
      "command": "python",
      "args": ["ABSOLUTE_PATH_TO_FRAMEWORK/mcp_server.py"],
      "env": {
        "PROFILE_VAULT": "ABSOLUTE_PATH_TO_PRIVATE_VAULT",
        "PROFILE_AGENT_ID": "client-issued-by-security-center",
        "PROFILE_CLIENT_TOKEN": "one-time-issued-credential"
      }
    }
  }
}
